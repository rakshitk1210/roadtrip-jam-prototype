# The Google Maps key is deliberately NOT committed: this repo is public and
# Google bills per map load, so a scraped key costs real money.
#
# Put your own key in `.env.local` (gitignored), which overrides this file:
#
#   VITE_GOOGLE_MAPS_KEY=your-key-here
#
# It needs the Maps JavaScript API enabled. Enable Routes API too if you want
# "Add stop" to recompute the drive rather than fall back to cached geometry.
VITE_GOOGLE_MAPS_KEY=
